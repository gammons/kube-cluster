# Copy to secrets.yml, replace the password, and apply.
# secrets.yml is git-ignored. Do not commit real values.
---
apiVersion: v1
kind: Secret
metadata:
  name: immich-postgres
  namespace: immich
type: Opaque
stringData:
  POSTGRES_USER: immich
  POSTGRES_PASSWORD: CHANGE_ME
  POSTGRES_DB: immich
